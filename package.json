		"@sveltejs/adapter-node": "^5.3.0",
		"@sveltejs/kit": "^2.22.0",
		"@sveltejs/vite-plugin-svelte": "^6.1.0",
		"@tailwindcss/vite": "^4.1.0",
		"@types/better-sqlite3": "^7.6.13",
		"@types/node": "^24.0.0",
		"drizzle-kit": "^0.31.0",
		"svelte": "^5.36.0",
		"tailwindcss": "^4.1.0",
		"tsx": "^4.20.0",
		"typescript": "^5.8.0",
		"vite": "^7.0.0",
		"vitest": "^3.2.0"
	}
